# Copy to .env for local development. Do not commit real secrets.

ENVIRONMENT=local

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TRANSACTION_EVENTS_TOPIC=transaction_events

POSTGRES_HOST=localhost
# Host port is separated from the container port to avoid conflicts with a
# Postgres installed directly on the machine.
POSTGRES_HOST_PORT=55432
# Local scripts connect through the host port. Containers still talk to Postgres
# on port 5432 inside the Docker network.
POSTGRES_PORT=55432
POSTGRES_DB=transaction_risk
POSTGRES_USER=risk_user
POSTGRES_PASSWORD=risk_password

MLFLOW_TRACKING_URI=http://localhost:5000
DATA_LAKE_ROOT=./data-lake

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_ENABLED=true
FEATURE_CACHE_TTL_SECONDS=300

# Local Airflow admin account. Override in .env if needed.
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me-local-only
AIRFLOW_ADMIN_FIRSTNAME=Local
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

BANKING_CORE_PORT=8084
AUTH_SERVICE_PORT=8085
FRAUD_API_BASE_URL=http://localhost:8000
FRAUD_API_CONNECT_TIMEOUT_MS=1000
FRAUD_API_READ_TIMEOUT_MS=1500
BANKING_CORE_SECURITY_ENABLED=false
BANKING_CORE_JWT_SECRET=local-dev-jwt-secret-change-me-32chars
AUTH_JWT_ISSUER=local-auth-service
AUTH_ACCESS_TOKEN_TTL_MINUTES=60
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8088
NEXT_PUBLIC_AUTH_API_BASE_URL=http://localhost:8085
NEXT_PUBLIC_BANKING_API_BASE_URL=http://localhost:8084
NEXT_PUBLIC_FRAUD_API_BASE_URL=http://localhost:8000

FRAUD_DECISION_API_PORT=8000
MODEL_NAME=fraud-risk-model
FALLBACK_MODEL_DIR=./pipelines/training/model-artifacts/fraud-risk-model
